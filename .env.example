# Copy to .env and replace both passwords before the first start.
MYSQL_ROOT_PASSWORD=replace_with_a_long_root_password
MYSQL_PASSWORD=replace_with_a_different_app_password
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
ACADEMY_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional: required when using compose.ngrok.yaml.
# Copy your authtoken and assigned HTTPS domain from the ngrok dashboard.
# Use the full https:// URL without a trailing slash.
NGROK_AUTHTOKEN=
NGROK_URL=
